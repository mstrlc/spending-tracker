# Copy to <DEPLOY_DIR>/.env on the Docker host and fill in. Keep it there (chmod 600); never commit it.

# Where the app is served (https://DOMAIN); the bank sends people back here after they agree to share their data.
DOMAIN=spend.example.com
# The Docker network your reverse proxy is on; it proxies DOMAIN to spending-web:80.
PROXY_NETWORK=proxy
# Where backup.sh writes the nightly dumps. Better on another drive than Docker's volumes.
BACKUP_DIR=/srv/backups/spending-tracker

# Generate with: openssl rand -hex 24
DB_PASSWORD=

# Optional: GoCardless Bank Account Data keys for live bank feeds.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Optional: SIGNUP=on lets anyone who reaches the site create an account (off by default; create the first
# accounts with it on, then turn it off). BANK_SYNC_HOUR=0-23 (Prague time) or off. JAVA_OPTS for the API's heap.
# SIGNUP=off
# BANK_SYNC_HOUR=5
# JAVA_OPTS=-Xmx384m -XX:+UseSerialGC -XX:MaxMetaspaceSize=160m
