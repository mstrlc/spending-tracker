# GoCardless Bank Account Data API keys (get them at https://bankaccountdata.gocardless.com/).
# Without them, bank connections are reported as not configured.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Where the bank redirects after consent (defaults to http://localhost:5173 in dev).
# APP_URL=http://localhost:5173

# Hour (0-23, Europe/Prague) for the daily bank sync, or "off" to disable. Defaults to 5.
# BANK_SYNC_HOUR=5

# Mark session cookies Secure (on for any https deployment, off for local http).
# SECURE_COOKIES=false
