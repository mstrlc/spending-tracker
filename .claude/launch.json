{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": [
        "--console=plain",
        "-q",
        ":server:run"
      ],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "dev",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
